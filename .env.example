# Producción / Coolify: usar Neon (neon.tech) — Postgres administrado en la nube.
# Usar la connection string "direct" (no la "pooled"/PgBouncer) y mantener sslmode=require.
# Ejemplo real de Neon: postgresql://usuario:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
#
# Desarrollo local: si no tenés Postgres local, también podés usar directamente un proyecto de Neon acá.
DATABASE_URL="postgresql://habitar:habitar@localhost:5432/habitar?schema=public"
JWT_SECRET="change-me"
PORT=4000

# URL pública del frontend — adonde redirige el backend después del login OAuth
# (CU-01-01) y en caso de error. En prod es el dominio real (ej. https://habitar.lat).
FRONTEND_URL=http://localhost:4321

# IA: DeepSeek (Fase 2 - generación de preguntas de comprensión lectora)
# Sin esta key, el sistema usa un generador de preguntas por plantillas (mock, sin IA).
DEEPSEEK_API_KEY=
DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions
DEEPSEEK_MODEL=deepseek-chat

# --- OAuth 2.0 / OIDC real (CU-01-01) ---
# Sin estos valores, GET /api/auth/google y /api/auth/microsoft devuelven error;
# el login simulado (POST /api/auth/login) sigue funcionando igual para desarrollo local.

# Google Workspace — https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: <URL pública del backend>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback

# Microsoft 365 / Azure AD (Entra ID) — https://portal.azure.com (App registrations)
# Redirect URI: <URL pública del backend>/api/auth/microsoft/callback
# MICROSOFT_TENANT_ID: "common" acepta cualquier cuenta Microsoft/organizacional;
# usar el Tenant ID específico para restringir a una sola organización.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URI=http://localhost:4000/api/auth/microsoft/callback
