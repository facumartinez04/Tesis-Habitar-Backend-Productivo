# Producción / Coolify: usar Neon (neon.tech) — Postgres administrado en la nube.
# Usar la connection string "direct" (no la "pooled"/PgBouncer) y mantener sslmode=require.
# Ejemplo real de Neon: postgresql://usuario:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
#
# Desarrollo local: si no tenés Postgres local, también podés usar directamente un proyecto de Neon acá.
DATABASE_URL="postgresql://habitar:habitar@localhost:5432/habitar?schema=public"
JWT_SECRET="change-me"
PORT=4000

# IA: DeepSeek (Fase 2 - generación de preguntas de comprensión lectora)
# Sin esta key, el sistema usa un generador de preguntas por plantillas (mock, sin IA).
DEEPSEEK_API_KEY=
DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions
DEEPSEEK_MODEL=deepseek-chat
